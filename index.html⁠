<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Асан қайғының Жерұйықты іздеу саяхаты</title>
    <style>
        body { font-family: sans-serif; margin: 0; padding: 20px; background: #f0f4f8; color: #333; }
        header { text-align: center; background: #2c3e50; color: white; padding: 20px; border-radius: 10px; }
        .container { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; }
        .card { flex: 1; min-width: 280px; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .btn { display: block; width: 100%; padding: 12px; margin: 8px 0; background: #3498db; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; text-align: left; }
        .btn:hover { background: #2980b9; }
        .info { background: #eef2f3; padding: 15px; border-left: 4px solid #3498db; border-radius: 4px; margin-top: 10px; }
    </style>
</head>
<body>

<header>
    <h1>📍 Асан қайғының Жерұйық ізденісі</h1>
    <p>Топонимикалық интерактивті карта-картасы</p>
</header>

<div class="container">
    <div class="card">
        <h3>Аймақты таңдаңыз:</h3>
        <button class="btn" onclick="show('ertis')">💧 Ертіс өзені</button>
        <button class="btn" onclick="show('syr')">💧 Сырдария (Сыр бойы)</button>
        <button class="btn" onclick="show('bayan')">Ы Баянауыл тауы</button>
        <button class="btn" onclick="show('karsak')">🏛 Қарсақбай аймағы</button>
        <button class="btn" onclick="show('akmesh')">🏛 Ақмешіт (Қызылорда)</button>
    </div>

    <div class="card">
        <h3 id="name">Ертіс өзені</h3>
        <div class="info">
            <strong>💬 Асан қайғының бағасы:</strong>
            <p id="quote">«Мына шіркіннің баласы тойдым деп қарап отырмас, қарным ашты деп жылап отырмас... Күнінде баласы кеуірден жылайды-ау!»</p>
        </div>
        <p><strong>📌 Түрі:</strong> <span id="type">Гидроним</span></p>
        <p><strong>📝 Тәсілі:</strong> <span id="method">Лексика-семантикалық</span></p>
    </div>
</div>

<script>
    const list = {
        ertis: { name: "Ертіс өзені", quote: "«Мына шіркіннің баласы тойдым деп қарап отырмас, қарным ашты деп жылап отырмас... Күнінде баласы кеуірден жылайды-ау!»", type: "Гидроним", method: "Лексика-семантикалық" },
        syr: { name: "Сырдария (Сыр бойы)", quote: "«Басы байпақ, аяғы қайқақ, екі-ақ ауылға қоныс екен, өн бойы кедейлікке біткен жер екен...»", type: "Гидроним", method: "Синтаксистік, аналитикалық" },
        bayan: { name: "Баянауыл тауы", quote: "«Ат ерін алуға жарамайтұғын жер екен, шіркінді жұрт қалай қоныс қылып отырған? Бауырында бір қара тиген тұзы бар екен...»", type: "Ороним", method: "Синтаксистік" },
        karsak: { name: "Қарсақбай аймағы", quote: "«Айналаң жапан түз екен, тауыңның асты жез екен, екі тауың ел біткенді шақырар, басыңа байлық қонар!»", type: "Ойконим", method: "Аналитикалық" },
        akmesh: { name: "Ақмешіт (Қызылорда)", quote: "«Ей, Ақмешіт, жерің шаң екен, суың жар екен, әр бұтаның түбінде кесек етің бар екен!»", type: "Ойконим", method: "Аналитикалық" }
    };

    function show(key) {
        document.getElementById('name').innerText = list[key].name;
        document.getElementById('quote').innerText = list[key].quote;
        document.getElementById('type').innerText = list[key].type;
        document.getElementById('method').innerText = list[key].method;
    }
</script>

</body>
</html>
